<?xml version="1.0" encoding="UTF-8"?>
<Window title="Hello OUIF" width="960" height="540" clear_color="#101218">
    
    <!-- 1. External CSS Stylesheet Imports -->
    <Stylesheet src="styles/base.css" />
    <Stylesheet src="styles/dark_theme.css" />

    <!-- 2. Local Embedded CSS (Overrides external files) -->
    <Style>
        .selected-tile {
            border: 4px solid #e8edf3dc;
        }
        #blue_tile:hover {
            opacity: 0.9;
        }
    </Style>

    <!-- 3. Declarative Widget Layout Tree (root must be a single widget) -->
    <RowLayout id="main_surface"
               class="surface-container"
               alignment="center"
               gap="32"
               policy="fill,fill"
               style="background: #1c1f26; border: 1px solid #647084; padding: 24px;">

        <!-- Tile 1: Styled via CSS Class + Specific Inline Style Override -->
        <ColorTile id="blue_tile"
                   class="color-tile tile-blue"
                   size="160,120"
                   style="background: #2f6c9c; hover-background: #4692c4;" />

        <Divider orientation="vertical" thickness="1" color="#647084" />

        <!-- Tile 2: Styled via Multiple CSS Classes -->
        <ColorTile id="violet_tile"
                   class="color-tile tile-violet selected-tile"
                   size="160,120" />

        <Spacer size="8,1" />

        <!-- Tile 3: Fully Inline Styled (No external CSS dependence) -->
        <ColorTile id="green_tile"
                   class="color-tile"
                   size="160,120"
                   style="background: #4c8a5f; hover-background: #68b07e; border: 2px solid #e8edf3dc;" />

    </RowLayout>
</Window>
